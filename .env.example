# Copy to .env.local and set the public key printed by map-api seed:
#   docker compose logs seed | grep "Map client key"
NEXT_PUBLIC_MAP_STYLE_URL=http://map-gateway.sabzevar.ir:8004/styles/style.json
NEXT_PUBLIC_MAP_API_KEY=
# If map.sabzevar.ir is HTTPS, use https://map-gateway.sabzevar.ir:8004/... after apply-map-8004.sh
